# --- Vercel preview (catalog is stored as commits in GitHub) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repository

# --- Regular hosting (node server.mjs): catalog and photos on the server disk ---
# STORAGE=fs
# DATA_DIR=/var/rewear          # holds data/products.json and images/; back it up
# PORT=3000
# PUBLIC_SITE_URL=https://rewear.ru
# TRUST_PROXY=1                 # behind nginx: take the client IP from X-Forwarded-For

# --- Admin login: normally private/admin.json (scripts/reset-admin.mjs), changed in the admin itself.
# Optional fallback when that file is absent: node scripts/hash-password.mjs
# ADMIN_LOGIN=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
