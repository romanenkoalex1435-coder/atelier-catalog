# systemd unit: sudo cp deploy/rewear.service /etc/systemd/system/ && sudo systemctl enable --now rewear
[Unit]
Description=REWEAR VINTAGE shop
After=network.target

[Service]
WorkingDirectory=/opt/rewear
ExecStart=/usr/bin/node server.mjs
EnvironmentFile=/opt/rewear/.env
Restart=always
User=rewear

[Install]
WantedBy=multi-user.target
